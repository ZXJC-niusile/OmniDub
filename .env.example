# ── OpenAI API (translation & summarization) ──────────────────────────
OPENAI_API_KEY = 'sk-xxx'
# OPENAI_API_BASE = 'https://api.openai.com/v1'
MODEL_NAME = 'gpt-3.5-turbo'
# Number of subtitle lines translated per LLM batch call (default: 10)
# TRANSLATION_BATCH_SIZE = '10'

# ── HuggingFace (WhisperX models & diarization) ───────────────────────
# Required by WhisperX to download ASR models and pyannote diarization.
# Accept HUGGINGFACE_TOKEN as a fallback alias.
HF_TOKEN = 'hf_xxx'
# HUGGINGFACE_TOKEN = 'hf_xxx'

# 如果从 huggingface 下载模型时报错，取消注释下面的代码
# HF_ENDPOINT = 'https://hf-mirror.com'

# ── WhisperX optional tuning ──────────────────────────────────────────
# Fallback alignment language when WhisperX has no align model for the
# detected source language (default: en).
# WHISPERX_ALIGN_FALLBACK_LANGUAGE = 'en'

# Optional: override the pyannote diarization model name.
# WHISPERX_DIARIZATION_MODEL =

# ── TTS optional tuning ───────────────────────────────────────────────
# Required ONLY when using tts_engine='xtts' (Coqui XTTS v2 under CPML).
# Point to a local directory containing self-downloaded XTTS v2 weights.
# OMNIDUB_XTTS_LOCAL_PATH = '/path/to/XTTS-v2'

# Controls how football formation numbers (e.g. 4-4-2) are read aloud.
# Options: chinese_compact | chinese_split | split_dunhao | split_comma | compact
# FORMATION_TTS_STYLE = 'chinese_compact'

# Optional: override subtitle font family used by ffmpeg/libass (default: sans-serif).
# SUBTITLE_FONT_NAME = 'sans-serif'
